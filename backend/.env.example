# -------------------------
# Server
# -------------------------
PORT=3001
NODE_ENV=development

# -------------------------
# Database (Postgres)
# -------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/studio_cast
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/studio_cast_shadow

# -------------------------
# JWT (RS256)
# -------------------------
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -------------------------
# OAuth (Google)
# -------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# -------------------------
# Cookies
# -------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# -------------------------
# App URLs
# -------------------------
MAGIC_LINK_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_BASE=http://localhost:3001

# -------------------------
# Cloudflare R2 (required)
# Chunks are uploaded directly from the browser to R2 via presigned PUT URLs.
# -------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public base URL for serving final assets (CDN or public R2 URL):
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com

# -------------------------
# R2 Bucket CORS — REQUIRED for browser direct upload
# -------------------------
# The browser PUTs chunks directly to R2 using presigned URLs.
# Without the correct CORS policy, every upload will fail with a network error.
#
# Apply this CORS configuration to your R2 bucket via the Cloudflare dashboard
# or wrangler CLI before running the studio:
#
# [
#   {
#     "AllowedOrigins": ["http://localhost:3000", "https://your-production-domain.com"],
#     "AllowedMethods": ["PUT"],
#     "AllowedHeaders": ["Content-Type", "Content-Length"],
#     "MaxAgeSeconds": 3600
#   }
# ]
#
# wrangler r2 bucket cors put your-bucket-name --rules '[{"AllowedOrigins":["http://localhost:3000"],"AllowedMethods":["PUT"],"AllowedHeaders":["Content-Type","Content-Length"],"MaxAgeSeconds":3600}]'

# -------------------------
# LiveKit
# -------------------------
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_WS_URL=wss://your-livekit-host

# -------------------------
# RNNoise (optional — backend ML audio denoising)
# -------------------------
# Path to an RNNoise .rnnn model file. When set, the transcode worker applies
# the arnndn ffmpeg filter to all audio tracks, removing background noise.
# Download a model from: https://github.com/GregorR/rnnoise-models
# Example model: beguiling-drafter-2018-08-30/bd.rnnn
# Leave unset to disable denoising.
# RNNOISE_MODEL_PATH=/app/models/bd.rnnn
